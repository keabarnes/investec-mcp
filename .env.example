# Investec API credentials
INVESTEC_CLIENT_ID=your_client_id
INVESTEC_CLIENT_SECRET=your_client_secret
INVESTEC_API_KEY=your_api_key

# MCP server configuration
# HOST defaults to 127.0.0.1 (this machine only); the Docker image sets 0.0.0.0
# HOST=0.0.0.0
PORT=8050
# Host names to accept behind a reverse proxy, comma-separated
# ALLOWED_HOSTS=pi.example.ts.net
# Options: sse, streamable-http, stdio
TRANSPORT=sse